# Base de datos
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/sistema-escolar-pro"

# Autenticación (generar con: openssl rand -base64 32)
AUTH_SECRET=

# URL pública de la aplicación (necesaria para enlaces de recuperación de contraseña)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Gemini AI
GOOGLE_GENERATIVE_AI_API_KEY=

# Opcional: confiar en host (solo desarrollo)
# AUTH_TRUST_HOST=true
